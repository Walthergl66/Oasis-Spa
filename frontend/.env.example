# Capa de datos del frontend.
# true  -> los servicios resuelven contra el repositorio local (localStorage). Modo actual.
# false -> los servicios llaman al backend NestJS vía axios usando VITE_API_URL.
VITE_USE_MOCK=true

# URL base de la API NestJS (se usará cuando VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:3000/api

# Puerto de la API
PORT=3000

# Origen permitido para CORS (el frontend Vite)
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL gestionado con Supabase ---
# En Supabase: Project Settings > Database > Connection string (usa el pooler para apps).
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_password
DB_NAME=postgres
# Supabase exige SSL
DB_SSL=true

# Nunca activar en producción: el esquema se gestiona con migraciones.
DB_SYNCHRONIZE=false
DB_LOGGING=false

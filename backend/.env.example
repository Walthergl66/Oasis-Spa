# Servidor
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=*

# Base de datos PostgreSQL
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=oasis_admin
DB_PASSWORD=oasis_secret
DB_DATABASE=oasis_spa_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Autenticación JWT (RNF-08)
JWT_SECRET=oasis_spa_jwt_secret_key_titulacion_2026_super_secure
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=oasis_spa_refresh_secret_key_titulacion_2026_super_secure
JWT_REFRESH_EXPIRES_IN=7d

# Seguridad y Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Zona horaria del Spa
SPA_TIMEZONE=America/Guayaquil

# Notificaciones Web Push (VAPID)
VAPID_PUBLIC_KEY=BK_mock_public_key_for_development_purposes_only_1234567890
VAPID_PRIVATE_KEY=mock_private_key_dev_1234567890
VAPID_SUBJECT=mailto:soporte@oasisspa.com

# Asistente Virtual LLM (RF-18, RNF-11)
# Opciones: mock | openai | gemini
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Seed inicial del Administrador (Sprint 1)
ADMIN_EMAIL=admin@oasisspa.com
ADMIN_PASSWORD=Admin1234*
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Oasis
ADMIN_PHONE=+593999999999

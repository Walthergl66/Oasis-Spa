# Puerto de la API
PORT=3000

# Orígenes permitidos para CORS: la PWA de la clienta y el panel administrativo.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# LOCAL (stack levantado con `npx supabase start`):
#   DB_HOST=127.0.0.1  DB_PORT=54322  DB_PASSWORD=postgres  DB_SSL=false
#
# SUPABASE EN LA NUBE — Project Settings > Database > Connection string,
# pestaña **Session pooler** (compatible con IPv4). Usa la sesión, NO el
# `Transaction pooler` del puerto 6543: ese no admite sentencias preparadas y
# TypeORM las usa.
#   DB_HOST=aws-0-<región>.pooler.supabase.com
#   DB_PORT=5432
#   DB_USERNAME=postgres.<referencia-del-proyecto>
#   DB_PASSWORD=<contraseña de la base>
#   DB_NAME=postgres
#   DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=54322
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL=false
#
# SUPABASE EN LA NUBE (Project Settings > Database > Session pooler):
#   DB_HOST=aws-0-<región>.pooler.supabase.com  DB_PORT=5432
#   DB_USERNAME=postgres.<referencia-del-proyecto>            DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=54322
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL=false

# El esquema se gestiona con migraciones. Nunca activar en producción.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---------------------------------------------------------------------------
# Supabase Auth (GoTrue)
# ---------------------------------------------------------------------------
# La identidad vive en auth.users; public.users es sólo el perfil de dominio.
# En local, `npx supabase status` imprime la URL y las claves.
SUPABASE_URL=

# Clave pública: iniciar sesión, registrar, refrescar y recuperar contraseña.
SUPABASE_ANON_KEY=

# Clave privilegiada: NUNCA debe salir del servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Sólo para proyectos antiguos que firman los JWT con secreto compartido.
# Los proyectos actuales usan claves asimétricas y no lo necesitan.
SUPABASE_JWT_SECRET=

# URL de la aplicación: a donde apuntan los enlaces de confirmación de
# correo y de recuperación de contraseña.
APP_URL=http://localhost:5173

# Cookie httpOnly donde viaja el refresh token.
REFRESH_COOKIE_NAME=oasis_rt

# ---------------------------------------------------------------------------
# Cuenta de administración (sólo para `npm run seed:catalogo`)
# ---------------------------------------------------------------------------
# Se crea una única vez. Mínimo 12 caracteres: tiene acceso total al sistema.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Documentación interactiva (Swagger)
# ---------------------------------------------------------------------------
# Publica el mapa completo de la API. Enciéndela sólo en desarrollo.
SWAGGER_ENABLED=false

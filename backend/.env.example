# Puerto de la API
PORT=3000

# Orígenes permitidos para CORS: la PWA de la clienta y el panel administrativo.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# LOCAL (stack de Supabase levantado con `npx supabase start`):
#   DB_HOST=127.0.0.1  DB_PORT=54322  DB_USERNAME=postgres  DB_PASSWORD=postgres
#   DB_NAME=postgres   DB_SSL=false
#
# SUPABASE EN LA NUBE (Project Settings > Database > Session pooler):
#   DB_HOST=aws-0-<región>.pooler.supabase.com  DB_PORT=5432
#   DB_USERNAME=postgres.<referencia-del-proyecto>            DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=54322
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL=false

# El esquema se gestiona con migraciones. Nunca activar en producción.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---------------------------------------------------------------------------
# Supabase Auth (GoTrue)
# ---------------------------------------------------------------------------
# La identidad vive en auth.users; `public.users` es sólo el perfil de dominio.
# Local: `npx supabase status` imprime la URL y las claves.
SUPABASE_URL=http://127.0.0.1:54321

# Clave pública: sólo se usa para iniciar sesión en nombre del usuario.
SUPABASE_ANON_KEY=

# Clave privilegiada: NUNCA debe salir del servidor ni llegar al navegador.
# Permite crear cuentas sin confirmación por correo (registro y seed).
SUPABASE_SERVICE_ROLE_KEY=

# Secreto con el que Supabase firma los JWT. El backend lo usa para verificar
# el access token que llega en cada petición.
SUPABASE_JWT_SECRET=

# Nombre de la cookie httpOnly donde viaja el refresh token.
REFRESH_COOKIE_NAME=oasis_rt
